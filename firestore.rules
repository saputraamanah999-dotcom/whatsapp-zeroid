rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function userDoc() { return get(/databases/$(db)/documents/users/$(me())).data; }
    function role() { return userDoc().role; }
    function isAdmin() { return signedIn() && (role() == 'admin' || role() == 'developer'); }
    function isMod() { return signedIn() && (role() == 'admin' || role() == 'developer' || role() == 'moderator'); }
    function notBanned() { return signedIn() && userDoc().banned != true; }

    function chat(chatId) { return get(/databases/$(db)/documents/chats/$(chatId)).data; }
    function isMemberOf(chatId) {
      return signedIn() && (chat(chatId).type == 'global' || chat(chatId).type == 'channel' || me() in chat(chatId).members);
    }
    function isChatAdmin(chatId) { return signedIn() && me() in chat(chatId).admins; }

    // Which user fields a normal user may touch on their own profile.
    function selfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name','about','avatar','banner','color','phone','username','pin','spotify',
                  'privacy','notif','blocked','contacts','lastSeen','otpCode','otpExpires',
                  'otpVerified','verified']);
    }
    // Which chat fields ANY member may touch (personal bookkeeping + send preview).
    function memberChatUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastRead','typing','pinnedBy','mutedBy','archivedBy','lastMsg']);
    }
    // Which chat fields ONLY chat admins (or global admins) may touch.
    function adminChatUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['members','admins','name','description','avatar','postPolicy','inviteCode','disappearing']);
    }
    // Message fields any member may touch (receipts, reactions, own stars).
    function memberMsgUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deliveredAt','reactions','starredBy']);
    }
    // Message fields the SENDER may additionally touch (edit, delete, media metadata).
    function senderMsgUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deliveredAt','deletedFor','deletedForAll','reactions','starredBy','text','editedAt','uri','thumb','storagePath']);
    }
    // In a direct chat, deny when the PEER has blocked me (server-side block, groups unaffected — same as WhatsApp).
    function otherDirect(chatId) {
      let ms = chat(chatId).members;
      return ms[0] == me() ? ms[1] : ms[0];
    }
    function peerBlocked(chatId) {
      let c = chat(chatId);
      return c.type == 'direct' && c.members.size() == 2
        && exists(/databases/$(db)/documents/users/$(otherDirect(chatId)))
        && me() in get(/databases/$(db)/documents/users/$(otherDirect(chatId))).data.blocked;
    }

    // ---- users ----
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn();
      // self write: limited field set (role/vip/blueCheck/banned are NOT writable)
      // BOOTSTRAP: while config/bootstrap does not exist yet, the first account
      // may claim role=developer (used once by seed.html; the seed then creates
      // config/bootstrap which closes this door forever).
      allow update: if (request.auth.uid == uid && selfProfileUpdate() && notBanned())
                    || (request.auth.uid == uid
                        && !exists(/databases/$(db)/documents/config/bootstrap)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
                    || isAdmin();
      allow create: if request.auth.uid == uid
                    && (request.resource.data.role == 'user'
                        || (request.resource.data.role == 'developer'
                            && !exists(/databases/$(db)/documents/config/bootstrap)));
      allow delete: if request.auth.uid == uid || isAdmin();
    }

    // unique username reservation
    match /usernames/{name} {
      allow get: if true;
      allow list: if true;
      allow create: if signedIn() && request.resource.data.uid == me() && !exists(/databases/$(db)/documents/usernames/$(name));
      allow update, delete: if signedIn() && (resource.data.uid == me() || isAdmin());
    }

    // push tokens
    match /fcm_tokens/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // ---- chats ----
    match /chats/{chatId} {
      allow get: if isMemberOf(chatId) || (resource.data.type in ['channel','global']);
      allow list: if signedIn();
      allow create: if signedIn() && notBanned() && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() > 0;
      // update matrix:
      //  1. global admins — full control
      //  2. chat admins — group settings (name/avatar/members/admins/policy/invite/disappearing)
      //  3. any member — personal bookkeeping (lastRead/typing/pin/mute/archive/lastMsg)
      //  4. non-member self-join via invite (members grow by exactly one: me)
      //  5. member self-leave / channel unfollow (members shrink by exactly one: me)
      allow update: if isAdmin()
                    || (isMemberOf(chatId) && isChatAdmin(chatId) && notBanned() && adminChatUpdate())
                    || (isMemberOf(chatId) && notBanned() && memberChatUpdate())
                    || (signedIn() && !(me() in resource.data.members)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members.hasAll(resource.data.members)
                        && request.resource.data.members.size() == resource.data.members.size() + 1)
                    || (signedIn() && me() in resource.data.members && !(me() in request.resource.data.members)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && resource.data.members.hasAll(request.resource.data.members)
                        && resource.data.members.size() == request.resource.data.members.size() + 1);
      allow delete: if isAdmin(); // hard delete: admins only (request.resource is null on delete)

      match /messages/{mid} {
        allow read: if isMemberOf(chatId);
        allow create: if signedIn() && notBanned()
                      && request.resource.data.senderId == me()
                      && isMemberOf(chatId)
                      && !peerBlocked(chatId)
                      && (chat(chatId).type != 'channel' || me() in chat(chatId).admins || chat(chatId).postPolicy == 'everyone' || isAdmin());
        allow update: if isAdmin()
                      || (isMemberOf(chatId) && notBanned() && memberMsgUpdate())
                      || (isMemberOf(chatId) && notBanned() && resource.data.senderId == me() && senderMsgUpdate());
        allow delete: if isAdmin() || (resource.data.senderId == me());
      }
    }

    // ---- stories (24h, cleaned by scheduled function) ----
    match /stories/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.userId == me()
                    && request.resource.data.expiresAt < request.time.toMillis() + 86400001;
      // others may only add themselves to viewers/likes
      allow update: if (resource.data.userId == me()) || isAdmin()
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers','likes'])
                        && request.resource.data.viewers.hasAll(resource.data.viewers)
                        && request.resource.data.likes.hasAll(resource.data.likes)
                        && (request.resource.data.viewers.size() + request.resource.data.likes.size())
                           == (resource.data.viewers.size() + resource.data.likes.size()) + 1);
      allow delete: if resource.data.userId == me() || isAdmin() || role() == 'moderator';
    }

    // ---- WebRTC calls & signaling (auto-cleaned client-side + TTL in functions) ----
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.callerId == me() || me() in resource.data.calleeIds);
      allow create: if signedIn() && notBanned() && request.resource.data.callerId == me()
                    && !peerBlocked(request.resource.data.chatId);
      allow update: if signedIn() && (resource.data.callerId == me() || me() in resource.data.calleeIds)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','connectedAt','endedAt']);
      allow delete: if resource.data.callerId == me() || isAdmin();
      match /signals/{sig} {
        allow read: if signedIn() && resource.data.to == me();
        allow create: if signedIn() && request.resource.data.from == me();
        allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      }
    }

    // ---- notifications (in-app notification center) ----
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.userId == me();
      allow create: if signedIn(); // written on message/group/story events by member clients
      allow update: if signedIn() && resource.data.userId == me();
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin());
    }

    // ---- reports (moderation queue) ----
    match /reports/{rid} {
      allow create: if signedIn() && notBanned();
      allow read, update, delete: if isMod();
    }

    // ---- premium orders (manual payment, admin approved) ----
    match /orders/{oid} {
      allow create: if signedIn() && notBanned() && request.resource.data.userId == me()
                    && request.resource.data.status == 'pending';
      allow read: if signedIn() && (resource.data.userId == me() || isMod());
      // only admins decide; status/decidedAt only
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedAt']);
      allow delete: if isAdmin();
    }

    // ---- stickers ----
    match /stickers/{sid} {
      allow read: if signedIn() && (resource.data.global == true || resource.data.ownerId == me());
      allow create: if signedIn() && notBanned() && request.resource.data.ownerId == me()
                    && (request.resource.data.global != true || isAdmin());
      allow delete: if resource.data.ownerId == me() || isAdmin();
    }

    // ---- anime favourites (private per-user watchlist) ----
    match /anime_favs/{fid} {
      allow read: if signedIn() && resource.data.uid == me();
      allow create: if signedIn() && notBanned() && request.resource.data.uid == me();
      allow update: if signedIn() && resource.data.uid == me() && request.resource.data.uid == me();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // ---- announcements (admin only writes, everyone reads) ----
    match /announcements/{aid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- audit log (append-only for admins) ----
    match /audit_logs/{lid} {
      allow read: if isMod();
      allow create: if isMod() && request.resource.data.actorId == me();
      allow update, delete: if false;
    }

    // ---- platform config (maintenance mode, flags) ----
    match /config/{cid} {
      allow read: if signedIn();
      // 'bootstrap' can be created exactly once by the account that claims it —
      // afterwards only admins may touch config.
      allow create: if isAdmin()
                    || (cid == 'bootstrap' && signedIn()
                        && request.resource.data.createdBy == me()
                        && !exists(/databases/$(db)/documents/config/bootstrap));
      allow update, delete: if isAdmin();
    }

    // ---- Trigger Email extension (OTP / transactional mail) ----
    match /mail/{id} {
      allow create: if signedIn() && notBanned();
      allow read: if isAdmin();
    }
  }
}
