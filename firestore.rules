rules_version = '2';
// ZEROID WHATSAPP — FIRESTORE RULES v20 (PUSH TOKEN LANGSUNG — IID/topic di-retire Google)
// v19: + vouchers (admin buat kode diskon; user HANYA bisa pola penukaran:
//        usedCount+1 & usedBy+=me pada voucher aktif/belum kadaluarsa/kuota sisa)
//      + guardconfig (skill AI Guard — read semua user login, write admin)
//      + guardlog (laporan AI Guard & login-guard — admin only)
//      + ledger ref_dev_*/ref_ip_* (bukti anti akun ganda referral — boleh dibaca
//        user login untuk cek klaim, ditulis sekali oleh pemiliknya)
// v18: + 'wallpaperFx' (efek wallpaper chat: opasitas per chat/default) di
//       whitelist profil sendiri. Perbaikan tampilan pribadi v16 (links/bubble/
//       wallpapers/chatTheme) tetap. Semua field ini HANYA bisa diubah oleh
//       PEMILIK profil sendiri — tidak bisa disuntik dari akun lain.
// v17: GRUP — kepemilikan & keluar masuk (pemilik dilindungi, transfer otomatis).
// v16: links/bubble/wallpapers/chatTheme, feedback, bot guard (zeroid-bot).
// v15: ekonomi check-in berbasis affectedKeys.
//  1. PEMILIK GRUP (createdBy = admin utama) DilindUNGI: admin kedua/user lain
//     TIDAK bisa menendang, menurunkan, atau mengalihkan kepemilikan pemilik —
//     hanya pemilik sendiri (atau admin global) yang bisa.
//  2. KELUAR GRUP anti "gak keluar-keluar": jalur keluar-sendiri sekarang PENUH —
//     anggota biasa (members saja), admin grup (members+admins sekaligus), dan
//     PEMILIK yang keluar + pindah admin utama OTOMATIS (members+admins+createdBy
//     dalam SATU tulisan; pemilik baru wajib anggota lama & terdaftar admin).
//  3. Transfer createdBy hanya boleh oleh pemilik lama / admin global, target
//     baru wajib masih jadi anggota grup hasil perubahan.
//  4. Penangguhan grup TIDAK menghalangi keluar-sendiri (anggota bebas pergi).
// v16: + links/bubble/wallpapers/chatTheme, feedback, bot guard (zeroid-bot).
// v15: ekonomi check-in berbasis affectedKeys.
// WAJIB terpasang di Firebase Console (atau otomatis via GitHub Actions).
// Cek status izin live: /seed.html (tes izin server) atau /rules.html (panduan pasang).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // ---- DEFENSIVE HELPERS (v8: + ledger, koin/referral, streak api) ----
    // Selama ini error "Missing or insufficient permissions" muncul karena rules
    // membaca field yang BELUM ADA di dokumen (banned, blocked, members, type…).
    // Di security rules, membaca key yang tidak ada = ERROR = rule otomatis MENOLAK.
    // Semua akses field memakai .get(key, default) sehingga dokumen lama
    // tanpa field baru tetap jalan.

    function userDoc() { return get(/databases/$(db)/documents/users/$(me())).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(db)/documents/users/$(me())); }
    function role() { return hasProfile() ? userDoc().get('role', 'user') : 'user'; }
    function isAdmin() { return signedIn() && (role() == 'admin' || role() == 'developer'); }
    function isMod() { return signedIn() && (role() == 'admin' || role() == 'developer' || role() == 'moderator'); }
    // banned / suspended / banUntil — toleran terhadap dokumen tanpa field tsb.
    function banBlocked() {
      return hasProfile() && (
        userDoc().get('banned', false) == true
        || userDoc().get('suspendedUntil', 0) > request.time.toMillis()
        || userDoc().get('banUntil', 0) > request.time.toMillis()
      );
    }
    function notBanned() { return signedIn() && !banBlocked(); }

    function chat(chatId) { return get(/databases/$(db)/documents/chats/$(chatId)).data; }
    function chatExists(chatId) { return exists(/databases/$(db)/documents/chats/$(chatId)); }
    function chatType(chatId) { return chatExists(chatId) ? chat(chatId).get('type', '') : ''; }
    function chatMembers(chatId) { return chatExists(chatId) ? chat(chatId).get('members', []) : []; }
    // v19 AUDIT: chat 'ai' TIDAK lagi terbuka untuk semua — wajib anggota
    // (dulu user mana pun bisa membaca percakapan AI milik user lain).
    function isMemberOf(chatId) {
      return signedIn() && chatExists(chatId) &&
        (chatType(chatId) == 'global' || chatType(chatId) == 'channel' || me() in chatMembers(chatId));
    }
    function isChatAdmin(chatId) { return signedIn() && chatExists(chatId) && me() in chat(chatId).get('admins', []); }

    // grup/saluran sedang dibanned admin? (banned=true permanen ATAU banUntil masa depan)
    function chatBanned(chatId) {
      return chatExists(chatId) && (
        chat(chatId).get('banned', false) == true
        || chat(chatId).get('banUntil', 0) > request.time.toMillis()
      );
    }

    // Which user fields a normal user may touch on their own profile.
    // v16: + links (tautan profil), bubble (gaya balon), wallpapers (wallpaper chat),
    //       chatTheme (tema warna chat) — semua data tampilan pribadi.
    // v18: + wallpaperFx (opasitas/efek wallpaper per chat atau default).
    function selfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name','about','avatar','banner','bannerType','color','phone','username','pin','spotify',
                  'privacy','notif','blocked','contacts','lastSeen','otpCode','otpExpires',
                  'otpVerified','verified','fcmToken','mutedUntil','orderAttempts','lastCallsSeenAt',
                  'links','bubble','wallpapers','wallpaperFx','chatTheme']);
    }

    // EKONOMI KOIN (v15 — FIX CHECK-IN DITOLAK UNTUK SEMUA USER BIASA):
    //   BUG LAMA (v9-v14): 'referralCode' in request.resource.data — pada update
    //   ber-fieldMask, request.resource.data = DOKUMEN GABUNGAN (hasil akhir), jadi
    //   field yang TIDAK diubah tetap "ada" di dalamnya. Akibatnya syarat
    //   "referralCode == ''" dievaluasi untuk SEMUA tulisan ekonomi → user yang
    //   sudah punya kode referral (semua user!) PERMANEN ditolak saat check-in
    //   (kecuali developer yang lewat jalur isAdmin). Pola sama merusak
    //   lastCheckinAt untuk tulisan ekonomi lain.
    //   FIX: semua syarat kini berbasis affectedKeys (k) — hanya field yang
    //   BENAR-BENAR berubah yang dihitung.
    // Rem ekonomi (tetap sama):
    //  - koin naik maks +6.000 per tulisan (check-in 1.500, referral 5.000) — 1 koin = Rp1
    //  - bestStreak / checkinStreak naik maks +1 per tulisan
    //  - ANTI-SPAM CHECK-IN: kalau lastCheckinAt berubah, WAJIB maju ≥19 jam
    //    (client pakai 20 jam; 19 jam toleransi jam perangkat) — tap-tap-tap DITOLAK SERVER
    //  - referralCode / referredBy hanya bisa diisi SEKALI (tidak bisa diganti)
    function selfEconomyUpdate() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      // v19 AUDIT (anti cetak koin): koin NAIK wajib ada BUKTI ledger dalam
      // transaksi yang sama — referral (ledger/{me}_ref, delta == kenaikan) atau
      // check-in (ledger/c_{uid}_{lastCheckinAt}, delta == kenaikan). Tulisan
      // 'points' saja tanpa bukti = DITOLAK server. Koin turun (belanja) bebas,
      // asal tidak minus. (getAfter di dokumen yang belum ada = error → karena
      // rules short-circuit, hanya dievaluasi saat koin memang naik.)
      let oldP = resource.data.get('points', 0);
      let newP = request.resource.data.get('points', oldP);
      let gain = newP - oldP;
      return k.hasOnly(['points','bestStreak','checkinStreak','lastCheckinAt','referralCode','referredBy','fireRevives'])
        && newP >= 0
        && (gain <= 0
            || getAfter(/databases/$(db)/documents/ledger/$(me() + '_ref')).data.get('delta', 0) == gain
            || getAfter(/databases/$(db)/documents/ledger/$('c_' + me() + '_' + string(request.resource.data.get('lastCheckinAt', 0)))).data.get('delta', 0) == gain)
        && (gain <= 0
            || request.resource.data.get('points', 0) <= resource.data.get('points', 0) + 6000)
        && (!k.hasAny(['bestStreak'])
            || request.resource.data.get('bestStreak', 0) <= resource.data.get('bestStreak', 0) + 1)
        && (!k.hasAny(['checkinStreak'])
            || request.resource.data.get('checkinStreak', 0) <= resource.data.get('checkinStreak', 0) + 1)
        && (!k.hasAny(['lastCheckinAt'])
            || (request.resource.data.get('lastCheckinAt', 0) > resource.data.get('lastCheckinAt', 0)
                && request.resource.data.get('lastCheckinAt', 0) >= resource.data.get('lastCheckinAt', 0) + 68400000))
        && (!k.hasAny(['referralCode'])
            || resource.data.get('referralCode', '') == '')
        && (!k.hasAny(['referredBy'])
            || resource.data.get('referredBy', '') == '');
    }

    // REFERRAL SILANG (v8): pendatang baru menghargai pengundangnya.
    // Syarat: hanya menyentuh points+refCount, refCount tepat +1, koin naik ≤600,
    // dan ledger/{me}_ref (bukti unik per pendatang) menunjuk ke pengundang ini.
    function referralCreditUpdate(targetUid) {
      // v19 AUDIT: nilai reward PASTI (tidak bisa dinaikkan) + bukti ledger
      // wajib kind 'referral_newbie' & delta 1000 — path raw v8 ditutup.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','refCount'])
        && request.resource.data.get('points', 0) - resource.data.get('points', 0) == 5000
        && request.resource.data.get('refCount', 0) == resource.data.get('refCount', 0) + 1
        && getAfter(/databases/$(db)/documents/ledger/$(me() + '_ref')).data.get('to', '') == targetUid
        && getAfter(/databases/$(db)/documents/ledger/$(me() + '_ref')).data.get('delta', 0) == 1000
        && getAfter(/databases/$(db)/documents/ledger/$(me() + '_ref')).data.get('kind', '') == 'referral_newbie';
    }

    // Which chat fields ANY member may touch (personal bookkeeping + send preview + patungan pot).
    function memberChatUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['lastRead','typing','pinnedBy','mutedBy','archivedBy','lastMsg','blueCheckPot','streakDeadNotifiedAt']);
    }

    // STREAK API (v8, pola affectedKeys sejak v15): anggota mana pun boleh
    // memutakhirkan api chat — streakCount maks +1 per tulisan, day/time monoton.
    function streakChatUpdate() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      return k.hasOnly(['streakCount','streakDay','streakUpdatedAt'])
        && (!k.hasAny(['streakCount'])
            || request.resource.data.get('streakCount', 1) <= resource.data.get('streakCount', 0) + 1)
        && (!k.hasAny(['streakDay'])
            || request.resource.data.get('streakDay', 0) >= resource.data.get('streakDay', 0))
        && (!k.hasAny(['streakUpdatedAt'])
            || request.resource.data.get('streakUpdatedAt', 0) >= resource.data.get('streakUpdatedAt', 0));
    }

    // Which chat fields ONLY chat admins (or global admins) may touch.
    // v17 OWNER GUARD: pemilik grup (createdBy) tidak bisa ditendang, diturunkan,
    // atau diganti oleh admin kedua/user lain. 'createdBy' kini boleh ditulis —
    // tapi HANYA oleh pemilik lama sendiri / admin global, dan pemilik baru
    // wajib masih terdaftar anggota (hasil perubahan). Menambahkan bot resmi
    // 'zeroid-bot' HANYA boleh oleh admin global (admin Developer).
    function adminChatUpdate() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      let addsBot = request.resource.data.get('members', []).hasAny(['zeroid-bot'])
                    && !resource.data.get('members', []).hasAny(['zeroid-bot']);
      let owner = resource.data.get('createdBy', '');
      // pemilik terdampak: dikeluarkan dari anggota / diturunkan dari admin /
      // kepemilikannya dipindahkan orang lain
      let ownerTouched = owner != '' && (
            !(owner in request.resource.data.get('members', []))
            || (owner in resource.data.get('admins', [])
                && !(owner in request.resource.data.get('admins', [])))
            || (k.hasAny(['createdBy'])
                && request.resource.data.get('createdBy', '') != owner));
      return k.hasOnly(['members','admins','name','description','avatar','postPolicy','inviteCode','disappearing','createdBy'])
        && (!addsBot || isAdmin())
        // transfer kepemilikan: hanya pemilik lama sendiri / admin global;
        // pemilik baru wajib anggota grup hasil perubahan
        && (!k.hasAny(['createdBy'])
            || ((owner == '' || owner == me() || isAdmin())
                && request.resource.data.get('createdBy', '') in request.resource.data.get('members', [])))
        // pelindung pemilik: admin kedua tidak bisa menyentuh posisi pemilik
        && (!ownerTouched || owner == me() || isAdmin());
    }
    // Message fields any member may touch (receipts, reactions, own stars, poll votes,
    // view-once open receipts).
    function memberMsgUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deliveredAt','reactions','starredBy','votes','viewedBy']);
    }
    // Message fields the SENDER may additionally touch (edit, delete, media metadata).
    function senderMsgUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['deliveredAt','deletedFor','deletedForAll','reactions','starredBy','text','editedAt','uri','thumb','storagePath']);
    }
    // In a direct chat, deny when the PEER has blocked me (server-side block, groups unaffected — same as WhatsApp).
    function otherDirect(chatId) {
      let ms = chatMembers(chatId);
      return ms[0] == me() ? ms[1] : ms[0];
    }
    function peerBlocked(chatId) {
      return chatType(chatId) == 'direct'
        && chatMembers(chatId).size() == 2
        && exists(/databases/$(db)/documents/users/$(otherDirect(chatId)))
        && me() in get(/databases/$(db)/documents/users/$(otherDirect(chatId))).data.get('blocked', []);
    }

    // ---- users ----
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if signedIn();
      // self write: limited field set (role/vip/blueCheck/banned are NOT writable)
      // BOOTSTRAP: while config/bootstrap does not exist yet, the first account
      // may claim role=developer (used once by seed.html; the seed then creates
      // config/bootstrap which closes this door forever).
      allow update: if (request.auth.uid == uid && selfProfileUpdate() && notBanned())
                    || (request.auth.uid == uid && notBanned() && selfEconomyUpdate())
                    || (signedIn() && notBanned() && referralCreditUpdate(uid))
                    || (request.auth.uid == uid
                        && !exists(/databases/$(db)/documents/config/bootstrap)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','blueCheck','developer']))
                    || isAdmin();
      allow create: if request.auth.uid == uid
                    && (request.resource.data.get('role', 'user') == 'user'
                        || (request.resource.data.get('role', 'user') == 'developer'
                            && !exists(/databases/$(db)/documents/config/bootstrap)))
                    || (isAdmin() && uid == 'zeroid-bot'); // profil BOT resmi dibuat admin Developer
      allow delete: if request.auth.uid == uid || isAdmin();
    }

    // unique username reservation
    match /usernames/{name} {
      allow get: if true;
      allow list: if true;
      allow create: if signedIn() && request.resource.data.get('uid', '') == me() && !exists(/databases/$(db)/documents/usernames/$(name))
                    || (isAdmin() && request.resource.data.get('uid', '') == 'zeroid-bot'); // BOT resmi
      allow update, delete: if signedIn() && (resource.data.get('uid', '') == me() || isAdmin());
    }

    // push tokens
    match /fcm_tokens/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // ---- chats ----
    match /chats/{chatId} {
      allow get: if isMemberOf(chatId) || (signedIn() && resource.get('type', '') in ['channel', 'global']);
      allow list: if signedIn();
      allow create: if signedIn() && notBanned() && request.auth.uid in request.resource.data.get('members', [])
                    && request.resource.data.get('members', []).size() > 0;
      // update matrix:
      //  1. global admins — full control
      //  2. chat admins — group settings (name/avatar/members/admins/policy/invite/disappearing)
      //  3. any member — personal bookkeeping (lastRead/typing/pin/mute/archive/lastMsg)
      //  4. any member — streak api chat (dengan rem antimanipulasi)
      //  5. non-member self-join via invite (members grow by exactly one: me)
      //  6. member self-leave / channel unfollow (members shrink by exactly one: me)
      allow update: if isAdmin()
                    || (isMemberOf(chatId) && isChatAdmin(chatId) && notBanned() && adminChatUpdate())
                    || (isMemberOf(chatId) && notBanned() && memberChatUpdate())
                    || (isMemberOf(chatId) && notBanned() && streakChatUpdate())
                    // banding ban grup/saluran: anggota hanya boleh menulis field banAppeal
                    || (isMemberOf(chatId) && notBanned() && chatBanned(chatId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banAppeal']))
                    // AI GUARD v11 — penangguhan OTOMATIS ala WhatsApp: anggota yang
                    // melihat pelanggaran (18+/spam) menangguhkan grup 60 menit.
                    // Rem ketat: HANYA field guard, alasan wajib prefix [AUTO],
                    // banUntil wajib di masa depan & maksimal +25 jam, grup belum
                    // dibanned (tidak bisa menimpa/memperpanjang keputusan admin).
                    || (isMemberOf(chatId) && notBanned() && !chatBanned(chatId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banUntil','banReason','suspendedAuto','autoBanAt','modOffense'])
                        && request.resource.data.get('banUntil', 0) > request.time.toMillis()
                        && request.resource.data.get('banUntil', 0) <= request.time.toMillis() + 90000001
                        && request.resource.data.get('banReason', '').matches('^\\[AUTO\\].*'))
                    || (signedIn() && !(me() in resource.data.get('members', []))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.get('members', []).hasAll(resource.data.get('members', []))
                        && request.resource.data.get('members', []).size() == resource.data.get('members', []).size() + 1)
                    // 6a. anggota biasa keluar sendiri / unfollow saluran (hanya members, berkurang 1: saya)
                    || (signedIn() && me() in resource.data.get('members', [])
                        && !(me() in request.resource.data.get('members', []))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && resource.data.get('members', []).hasAll(request.resource.data.get('members', []))
                        && resource.data.get('members', []).size() == request.resource.data.get('members', []).size() + 1)
                    // 6b. v17 ADMIN GRUP keluar sendiri — keluar dari anggota + turun
                    //     dari admin dalam SATU tulisan (dulu: hanya 'members' yang
                    //     diizinkan → admin yang keluar SELALU DITOLAK → "gak keluar-
                    //     keluar, masih bisa chat lagi")
                    || (signedIn() && me() in resource.data.get('members', [])
                        && me() in resource.data.get('admins', [])
                        && !(me() in request.resource.data.get('members', []))
                        && !(me() in request.resource.data.get('admins', []))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins'])
                        && resource.data.get('members', []).hasAll(request.resource.data.get('members', []))
                        && resource.data.get('members', []).size() == request.resource.data.get('members', []).size() + 1
                        && resource.data.get('admins', []).hasAll(request.resource.data.get('admins', []))
                        && resource.data.get('admins', []).size() == request.resource.data.get('admins', []).size() + 1)
                    // 6c. v17 PEMILIK keluar + pindah admin utama OTOMATIS ke anggota
                    //     lain dalam satu tulisan (suksesor wajib anggota lama yang
                    //     jadi admin; tidak ada anggota lain yang ikut terbuang)
                    || (signedIn() && resource.data.get('createdBy', '') == me()
                        && me() in resource.data.get('members', [])
                        && !(me() in request.resource.data.get('members', []))
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','createdBy'])
                        && resource.data.get('members', []).hasAll(request.resource.data.get('members', []))
                        && resource.data.get('members', []).size() == request.resource.data.get('members', []).size() + 1
                        && request.resource.data.get('createdBy', '') != me()
                        && request.resource.data.get('createdBy', '') in request.resource.data.get('members', [])
                        && request.resource.data.get('createdBy', '') in request.resource.data.get('admins', [])
                        && resource.data.get('members', []).hasAll(request.resource.data.get('admins', [])));
      allow delete: if isAdmin(); // hard delete: admins only (request.resource is null on delete)

      match /messages/{mid} {
        allow read: if isMemberOf(chatId);
        // v16: selain pengirim sendiri, ADMIN GLOBAL boleh menulis SEBAGAI BOT resmi
        // (senderId='zeroid-bot') — hanya di chat di mana bot benar-benar anggota.
        allow create: if signedIn() && notBanned()
                      && (request.resource.data.get('senderId', '') == me()
                          || (isAdmin()
                              && request.resource.data.get('senderId', '') == 'zeroid-bot'
                              && exists(/databases/$(db)/documents/chats/$(chatId))
                              && 'zeroid-bot' in chat(chatId).get('members', [])))
                      && isMemberOf(chatId)
                      && !peerBlocked(chatId)
                      && (!chatBanned(chatId) || isAdmin()) // grup/saluran dibanned → hanya admin bisa mengirim
                      // AI Anti-Spam: user yang sedang dimute tidak bisa mengirim (admin tetap bebas)
                      && (isAdmin()
                          || !hasProfile()
                          || (userDoc().get('mutedUntil', 0) <= request.time.toMillis()))
                      && (chatType(chatId) != 'channel' || isChatAdmin(chatId) || chat(chatId).get('postPolicy', 'everyone') == 'everyone' || isAdmin());
        allow update: if isAdmin()
                      || (isMemberOf(chatId) && notBanned() && memberMsgUpdate())
                      || (isMemberOf(chatId) && notBanned() && resource.data.get('senderId', '') == me() && senderMsgUpdate());
        allow delete: if isAdmin() || (resource.data.get('senderId', '') == me());
      }
    }

    // ---- stories (24h, cleaned by scheduled function) ----
    match /stories/{sid} {
      allow read: if signedIn();
      // Jendela kadaluarsa 48 jam (bukan 24h+1s): jam HP sering beda beberapa
      // detik/menit dari server — itulah penyebab "gagal mengirim Story
      // gagal izinkan firebase". Klien mengirim 24h; 24 jam toleransi jam.
      allow create: if signedIn() && notBanned() && request.resource.data.get('userId', '') == me()
                    && request.resource.data.get('expiresAt', 0) < request.time.toMillis() + 172800001
                    && request.resource.data.get('expiresAt', 0) > request.time.toMillis() - 3600000;
      // others may only add themselves to viewers/likes
      allow update: if (resource.data.get('userId', '') == me()) || isAdmin()
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers','likes'])
                        && request.resource.data.get('viewers', []).hasAll(resource.data.get('viewers', []))
                        && request.resource.data.get('likes', []).hasAll(resource.data.get('likes', []))
                        && (request.resource.data.get('viewers', []).size() + request.resource.data.get('likes', []).size())
                           == (resource.data.get('viewers', []).size() + resource.data.get('likes', []).size()) + 1);
      allow delete: if resource.data.get('userId', '') == me() || isAdmin() || role() == 'moderator';
    }

    // ---- WebRTC calls & signaling (auto-cleaned client-side + TTL in functions) ----
    // v10: hiddenFor — riwayat panggilan bisa dihapus PER USER (pilih beberapa / hapus semua)
    // tanpa menghapus riwayat pihak lain (sama seperti WhatsApp: "hapus untuk saya").
    match /calls/{callId} {
      allow read: if signedIn() && (resource.data.get('callerId', '') == me() || me() in resource.data.get('calleeIds', []));
      allow create: if signedIn() && notBanned() && request.resource.data.get('callerId', '') == me()
                    && !peerBlocked(request.resource.data.get('chatId', ''));
      allow update: if signedIn() && (resource.data.get('callerId', '') == me() || me() in resource.data.get('calleeIds', []))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','connectedAt','endedAt','hiddenFor'])
                    // hiddenFor hanya bertambah (union), tidak pernah menyusut / menulis field lain
                    // (v15: cek berbasis affectedKeys — jangan evaluasi hiddenFor saat field ini
                    //  tidak berubah; request.resource.data = dokumen gabungan pada fieldMask)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenFor'])
                        || (request.resource.data.get('hiddenFor', []).hasAll(resource.data.get('hiddenFor', []))
                            && request.resource.data.get('hiddenFor', []).size() >= resource.data.get('hiddenFor', []).size()
                            && me() in request.resource.data.get('hiddenFor', [])));
      allow delete: if resource.data.get('callerId', '') == me() || isAdmin();
      match /signals/{sig} {
        allow read: if signedIn() && resource.data.get('to', '') == me();
        allow create: if signedIn() && request.resource.data.get('from', '') == me();
        allow delete: if signedIn() && (resource.data.get('from', '') == me() || resource.data.get('to', '') == me());
      }
    }

    // ---- group/channel invite links (join by code) ----
    match /invites/{iid} {
      allow get, list: if signedIn();
      allow create: if signedIn() && notBanned() && request.resource.data.get('createdBy', '') == me();
      allow update, delete: if resource.data.get('createdBy', '') == me() || isAdmin();
    }

    // ---- notifications (in-app notification center) ----
    match /notifications/{nid} {
      allow read: if signedIn() && resource.data.get('userId', '') == me();
      allow create: if signedIn(); // written on message/group/story events by member clients
      allow update: if signedIn() && resource.data.get('userId', '') == me();
      allow delete: if signedIn() && (resource.data.get('userId', '') == me() || isAdmin());
    }

    // ---- reports (moderation queue) ----
    match /reports/{rid} {
      allow create: if signedIn() && notBanned();
      allow read, update, delete: if isMod();
    }

    // ---- bans (admin moderation bookkeeping; mirror of user ban fields) ----
    // v9: pengguna yang SEDANG dibanned boleh melengkapi IP-nya sendiri
    // (lastIp/ips) — bahan anti evasion; tidak bisa mengubah alasan/durasi.
    match /bans/{uid} {
      allow get: if signedIn() && (uid == me() || isMod());
      allow list: if isMod();
      allow create, update: if isMod()
        || (request.auth.uid == uid && banBlocked()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ips','lastIp']));
      allow delete: if isMod();
    }

    // ---- banips (anti buat akun baru saat diblokir) v11 ----
    // dokumen id = sha256(ip) atau 's24_'+sha256(subnet). Hanya user yang SEDANG
    // DIBANNED boleh menulis identitas-nya sendiri (uid harus = dirinya); semua
    // user ter-auth bisa MEMBACA (dipakai gerbang daftar/login); ADMIN bebas
    // menulis (mem-kunci IP/perangkat target saat adminBan) & query per-uid (unban).
    match /banips/{ipHash} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || (banBlocked()
            && request.resource.data.get('uid', '') == me()
            && request.resource.data.get('at', 0) <= request.time.toMillis() + 3600000);
      allow delete: if isAdmin();
    }

    // ---- devices (v11: fingerprint perangkat anti ban-evasion) ----
    // id = device hash. Klien menulis miliknya saat DIBANNED (lihat ban & banding);
    // admin menulis saat adminBan (dari usermeta) & mem-buka saat adminUnban.
    match /devices/{deviceHash} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        || (banBlocked()
            && request.resource.data.get('uid', '') == me()
            && request.resource.data.get('at', 0) <= request.time.toMillis() + 3600000);
      allow delete: if isAdmin();
    }

    // ---- usermeta (v11: IP/perangkat terakhir per akun, ditulis klien sendiri) ----
    // Hanya field teknis hash (bukan IP mentah) — admin membacanya saat mem-ban.
    // FIX v13: create TIDAK BOLEH memakai resource.data (resource = null saat create
    // → diff() error → seluruh kondisi false → seed & catatan sesi selalu ditolak).
    // Create memakai diff({}) — affectedKeys = semua field yang ditulis.
    match /usermeta/{uid} {
      allow get: if signedIn() && (uid == me() || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth.uid == uid
        && request.resource.data.diff({}).affectedKeys().hasOnly(['lastIpHash','lastDeviceHash','at']);
      allow update: if request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastIpHash','lastDeviceHash','at']);
      allow delete: if isAdmin();
    }

    // ---- appeals (user kirim keterangan saat dibanned — seperti WhatsApp) ----
    // PENTING: pengguna yang SEDANG dibanned harus tetap bisa mengirim banding,
    // jadi create TIDAK memakai notBanned().
    match /appeals/{uid} {
      allow get: if signedIn() && (uid == me() || isMod());
      allow list: if isMod();
      allow create: if request.auth.uid == uid;
      // pemilik boleh melengkapi selama belum diputus; mod boleh memutus (status/decidedAt/note)
      allow update: if (request.auth.uid == uid
                        && resource.data.get('status', 'pending') == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message','status','updatedAt']))
                    || (isMod()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedAt','adminNote']));
      allow delete: if isMod();
    }

    // ---- premium orders (manual payment / koin, admin approved) ----
    match /orders/{oid} {
      // v19 AUDIT: harga/hari dibatasi wajar (anti pesanan palsu Rp1 / 100 tahun).
      allow create: if signedIn() && notBanned() && request.resource.data.get('userId', '') == me()
                    && request.resource.data.get('status', '') == 'pending'
                    && request.resource.data.get('price', 0) >= 0
                    && request.resource.data.get('price', 0) <= 200000
                    && request.resource.data.get('days', 0) >= 0
                    && request.resource.data.get('days', 0) <= 400;
      allow read: if signedIn() && (resource.data.get('userId', '') == me() || isMod());
      // only admins decide; status/decidedAt only
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedAt']);
      allow delete: if isAdmin();
    }

    // ---- stickers ----
    match /stickers/{sid} {
      allow read: if signedIn() && (resource.data.get('global', false) == true || resource.data.get('ownerId', '') == me());
      allow create: if signedIn() && notBanned() && request.resource.data.get('ownerId', '') == me()
                    && (request.resource.data.get('global', false) != true || isAdmin());
      allow delete: if resource.data.get('ownerId', '') == me() || isAdmin();
    }

    // ---- anime favourites (private per-user watchlist) ----
    match /anime_favs/{fid} {
      allow read: if signedIn() && resource.data.get('uid', '') == me();
      allow create: if signedIn() && notBanned() && request.resource.data.get('uid', '') == me();
      allow update: if signedIn() && resource.data.get('uid', '') == me() && request.resource.data.get('uid', '') == me();
      allow delete: if signedIn() && resource.data.get('uid', '') == me();
    }

    // ---- FEEDBACK / MASUKAN user → developer (v16) ----
    // User membuat masukan miliknya (status selalu 'open' saat create, tanpa balasan);
    // admin membaca semua + mengisi reply/reward/status; pemilik hanya bisa menandai
    // sudah dibaca (readByUser). Koin apresiasi ditulis lewat transaksi terpisah.
    match /feedback/{fid} {
      allow create: if signedIn() && notBanned()
                    && request.resource.data.get('uid', '') == me()
                    && request.resource.data.get('status', '') == 'open'
                    && request.resource.data.get('reply', '') == ''
                    && request.resource.data.get('reward', 0) == 0
                    && request.resource.data.get('text', '').size() > 0
                    && request.resource.data.get('text', '').size() <= 2000;
      allow read: if signedIn() && (resource.data.get('uid', '') == me() || isAdmin());
      allow update: if isAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reply','repliedAt','reward','handledBy'])
                    || (signedIn()
                        && resource.data.get('uid', '') == me()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByUser']));
      allow delete: if isAdmin();
    }

    // ---- LEDGER KOIN (v9) — bukti setiap perubahan koin (referral, check-in, belanja) ----
    match /ledger/{lid} {
      // FIX v14: get pada doc yang BELUM ADA tidak lagi ditolak (resource null saat
      // get doc kosong → pakai !exists() sebagai jalur) supaya getDoc pra-transaksi
      // check-in tidak melempar permission-denied palsu.
      // v19: bukti referral per perangkat/IP (ref_dev_*/ref_ip_*) boleh DIBACA
      // user login mana pun (isinya hanya uid/kind/at — dipakai cek "perangkat ini
      // sudah pernah klaim referral?"); penulisannya tetap sekali oleh pemilik.
      allow read: if signedIn() && (!exists() || resource.data.get('uid', me()) == me() || isMod()
                    || lid.matches('^ref_(dev|ip)_.*'));
      allow create: if signedIn() && notBanned()
                    && request.resource.data.get('uid', '') == me()
                    && request.resource.data.get('delta', 0) <= 6000
                    && request.resource.data.get('delta', 0) >= -1000000
      // v16 APRESIASI MASUKAN: admin memberi koin ke user lewat balasan feedback
                    || (isMod()
                        && request.resource.data.get('kind', '') == 'feedback_reward'
                        && request.resource.data.get('delta', 0) <= 6000
                        && request.resource.data.get('delta', 0) >= 0);
      allow update, delete: if false; // append-only
    }

    // ---- v19 VOUCHER DISKON (admin panel → ditukar di Zeroid Premium) ----
    match /vouchers/{vid} {
      allow read: if signedIn(); // isinya bukan rahasia (kode dibagikan admin)
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // PENUKARAN OLEH USER — pola ketat: HANYA usedCount+1 & usedBy+=me,
        // voucher aktif, belum kedaluarsa, kuota masih ada, user belum memakai;
        // usedBy baru wajib memuat SEMUA entri lama (ukuran +1) — mustahil
        // menghapus/menambah nama lain.
        || (signedIn() && notBanned()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount','usedBy'])
            && request.resource.data.get('usedCount', 0) == resource.data.get('usedCount', 0) + 1
            && request.resource.data.get('usedBy', []).size() == resource.data.get('usedBy', []).size() + 1
            && me() in request.resource.data.get('usedBy', [])
            && !(me() in resource.data.get('usedBy', []))
            && request.resource.data.get('usedBy', []).hasAll(resource.data.get('usedBy', []))
            && resource.data.get('active', false) == true
            && (resource.data.get('expiresAt', 0) == 0 || resource.data.get('expiresAt', 0) > request.time.toMillis())
            && resource.data.get('usedCount', 0) < resource.data.get('maxUses', 1));
    }

    // ---- v19 AI GUARD: konfigurasi skill + log eksekusi ----
    match /guardconfig/{gid} {
      allow read: if signedIn(); // klien membaca untuk tampilkan status
      allow write: if isAdmin();
    }
    match /guardlog/{lid} {
      allow read: if isMod();
      allow write: if false; // ditulis HANYA oleh server (service account)
    }

    // ---- v19 SECRETS SERVER (kunci API cadangan) — DILARANG untuk semua klien ----
    // Hanya kode server dengan service account yang bisa membaca/menulis
    // (service account melewati rules). Isi: secrets/ai { JEREXD_APIKEY, ... }.
    match /secrets/{sid} {
      allow read, write: if false;
    }

    // ---- fcmtokens (v20: token push per perangkat — server-only) ----
    // v20: API IID Google di-retire (scope instance.id tak bisa access_token,
    // endpoint IID 401) → push berbasis TOPIC mustahil. Penggantinya: token FCM
    // disimpan oleh /api/fcm (service account) di fcmtokens/t_{sha256}, dan
    // /api/notify mengirim LANGSUNG ke token via FCM HTTP v1. Klien tidak
    // pernah membaca/menulis koleksi ini (token = kredensial kirim pesan).
    match /fcmtokens/{tid} {
      allow read, write: if false;
    }

    // ---- announcements (admin only writes, everyone reads) ----
    match /announcements/{aid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---- audit log (append-only for admins) ----
    match /audit_logs/{lid} {
      allow read: if isMod();
      allow create: if isMod() && request.resource.data.get('actorId', '') == me();
      allow update, delete: if false;
    }

    // ---- platform config (maintenance mode, flags) ----
    match /config/{cid} {
      allow read: if signedIn();
      // 'bootstrap' can be created exactly once by the account that claims it —
      // afterwards only admins may touch config.
      allow create: if isAdmin()
                    || (cid == 'bootstrap' && signedIn()
                        && request.resource.data.get('createdBy', '') == me()
                        && !exists(/databases/$(db)/documents/config/bootstrap));
      allow update, delete: if isAdmin();
    }

    // ---- Trigger Email extension (OTP / transactional mail) ----
    // v8: ANTI SPAM RELAY — hanya boleh mengirim ke email akun sendiri.
    match /mail/{id} {
      allow create: if signedIn() && notBanned()
                    && (request.resource.data.get('to', '') == request.auth.token.get('email', '')
                        || (hasProfile() && request.resource.data.get('to', '') == userDoc().get('email', '')));
      allow read: if isAdmin();
    }
  }
}
