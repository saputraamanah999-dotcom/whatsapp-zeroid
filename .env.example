# ============================================================
# ZEROID WHATSAPP — environment variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# SEMUA variabel EXPO_PUBLIC_* akan ter-bundle ke browser/APK —
# jangan pernah menaruh kunci rahasia di sini.
# ============================================================

# --- Firebase (web app) — Project settings > General > Your apps ---
# Panduan lengkap: docs/FIREBASE_SETUP.md
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=projekwhattsaf.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=projekwhattsaf
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=projekwhattsaf.appspot.com
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Penyedia login opsional (aktifkan provider di Firebase console dulu) ---
# 1 = tampilkan tombol Google Sign-In di halaman login
EXPO_PUBLIC_ENABLE_GOOGLE=0
# 1 = tampilkan alur Phone OTP (butuh Blaze plan di banyak project)
EXPO_PUBLIC_ENABLE_PHONE=0

# --- WebRTC TURN (opsional, sangat disarankan untuk jaringan NAT ketat) ---
# Contoh: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
EXPO_PUBLIC_TURN_URL=
EXPO_PUBLIC_TURN_USER=
EXPO_PUBLIC_TURN_CRED=

# --- Alamat server proxy AI / Musik / Anime (PENTING untuk fitur Jerexd) ---
# Fitur AI, musik, dan anime memanggil serverless function /api/ai & /api/jere
# yang kuncinya (JEREXD_APIKEY) disimpan di server — TIDAK di aplikasi.
#  • Web di-deploy lewat Vercel (folder api/ ikut ter-deploy):
#      boleh dibiarkan kosong (dipakai path relatif same-origin).
#  • APK Android / hosting web selain Vercel tersebut:
#      WAJIB diisi URL deployment Vercel Anda, contoh:
EXPO_PUBLIC_API_BASE=
# EXPO_PUBLIC_API_BASE=https://zeroid-anda.vercel.app

# --- Supabase (BARU — digabung dengan Firebase) ---
# Anon key memang dirancang PUBLIC (dilindungi RLS) → aman di client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# VARIABEL SERVER-SIDE (hanya di Vercel / Functions — TIDAK di client)
# Atur lewat: Vercel Dashboard > Settings > Environment Variables
# ============================================================
# Kunci API Jerexd (https://api.jerexd.my.id) — dipakai proxy /api/ai
JEREXD_APIKEY=
# (opsional tapi DISARANKAN) kunci ImgBB gratis (https://api.imgbb.com) — bila diisi,
# FOTO yang diunggah lewat /api/upload disimpan PERMANEN di ImgBB. Tanpa ini, foto
# memakai rantai host gratis yang sudah teruji (x0.at → uguu → tmpfiles);
# x0.at bertahan lama (30 hari - 1 tahun), uguu/tmpfiles sementara (3 jam / 1 jam).
# CATATAN VIDEO BESAR: video/audio/dokumen > 3.2 MB TIDAK lewat server ini —
# aplikasi mengunggahnya LANGSUNG dari perangkat pengguna ke host CORS
# (litterbox 72 jam → tmpfiles 1 jam), jadi video sampai 80 MB tetap bisa dikirim.
IMGBB_KEY=

# --- Sylvatica (BARU) — stiker Brat (/api/sylvatica) + AI fallback + TikTok dl ---
SYLVATICA_APIKEY=

# --- Supabase server-side (BARU — media PERMANEN + database) ---
# SUPABASE_URL + SERVICE ROLE key: upload media dari server (api/upload.ts).
# SERVICE ROLE = kunci super admin — JANGAN pernah ditaruh di EXPO_PUBLIC_*!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Koneksi Postgres langsung — hanya dipakai endpoint /api/supabase-seed
# untuk MEMBUAT TABEL OTOMATIS (jalankan sekali setelah env terpasang).
POSTGRES_URL_NON_POOLING=
