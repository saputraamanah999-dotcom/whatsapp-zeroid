{
  "expo": {
    "name": "Zeroid WhatsApp",
    "slug": "zeroid-whatsapp",
    "scheme": "zeroid",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeroid.whatsapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Zeroid-whatsapp membutuhkan kamera untuk video call, foto, dan Story.",
        "NSMicrophoneUsageDescription": "Zeroid-whatsapp membutuhkan mikrofon untuk voice note dan panggilan.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.zeroid.whatsapp",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1E6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Zeroid WhatsApp",
      "themeColor": "#1E78FF"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#E9EDF3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#151A22"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1E78FF",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zeroid-whatsapp membutuhkan akses galeri untuk mengirim foto dan video.",
          "cameraPermission": "Zeroid-whatsapp membutuhkan kamera untuk mengambil foto dan Story.",
          "microphonePermission": "Zeroid-whatsapp membutuhkan mikrofon untuk merekam video."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Zeroid-whatsapp membutuhkan mikrofon untuk voice note."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zeroid-whatsapp membutuhkan lokasi untuk berbagi posisi di chat."
        }
      ],
      "expo-document-picker",
      "expo-font",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Zeroid-whatsapp membutuhkan kamera untuk video call.",
          "microphonePermission": "Zeroid-whatsapp membutuhkan mikrofon untuk panggilan."
        }
      ],
      "./plugins/withZeroidAndroid.js"
    ],
    "extra": {
      "firebaseProjectId": "projekwhattsaf",
      "eas": {
        "projectId": "552f0665-e30d-4f11-9ea9-97bc22a22809"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/552f0665-e30d-4f11-9ea9-97bc22a22809"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "arcadalabs",
    "platforms": [
      "ios",
      "android",
      "web"
    ]
  }
}
